---

import { site } from '../data/site';
import { asset } from '../utils/paths';

/**
 * Ankers krijgen het homepad ervoor: op subpagina's (zoals /privacy)
 * bestaan die secties niet, waardoor een kaal #anker daar niets deed.
 */
const home = asset('');

const columns = [
  {
    title: 'Oplossingen',
    links: [
      { label: 'Netwerk & wifi', href: `${home}#oplossingen` },
      { label: 'Bekabeling', href: `${home}#oplossingen` },
      { label: 'Netwerkbeheer', href: `${home}#oplossingen` },
      { label: 'Monitoring', href: `${home}#oplossingen` },
    ],
  },
  {
    title: 'Voor wie',
    links: [
      { label: 'Studentenhuisvesting', href: `${home}#voor-wie` },
      { label: 'KMO’s & bedrijven', href: `${home}#voor-wie` },
      { label: 'Appartementsgebouwen', href: `${home}#voor-wie` },
    ],
  },
  {
    title: 'Over CE-iT',
    links: [
      { label: 'Over ons', href: `${home}#over` },
      { label: 'Werkwijze', href: `${home}#werkwijze` },
      { label: 'Contact', href: `${home}#contact` },
    ],
  },
];
---

<footer class="border-t border-line bg-white">
  <div
    class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-10 md:grid-cols-[2fr_1fr_1fr_1fr_1.2fr]"
  >
    <div>
      <img
        src={asset('images/logo/ce-it-logo-full.png')}
        alt="CE-iT — The Science of Connection"
        class="h-16 w-auto"
        width="2400"
        height="800"
        loading="lazy"
        decoding="async"
      />
      <p class="mt-5 max-w-xs text-[13.5px] leading-relaxed text-ink-600">
        Netwerk, wifi en bekabeling voor studentengebouwen en KMO’s.
        Installatie, optimalisatie en beheer.
      </p>
      {/* Socials verschijnen pas als de gegevens in site.ts staan */}
      {
        (site.linkedin || site.email) && (
          <ul class="mt-5 flex gap-3">
            {site.linkedin && (
              <li>
                <a
                  href={site.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="LinkedIn (opent in een nieuw tabblad)"
                  class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-600 transition-colors hover:border-brand-500 hover:text-brand-600"
                >
                  {/* Het officiële LinkedIn-woordmerk ("in"-bug), niet de
                      letters in onze eigen letter. In currentColor, zodat
                      hij dezelfde tint en hover volgt als het e-mailicoon:
                      LinkedIn-blauw ernaast zou botsen met de regel dat
                      CE-iT-blauw de enige accentkleur is (design brief §4).
                      viewBox is 448x512, dus niet vierkant — met de
                      standaard preserveAspectRatio schaalt hij zonder
                      vervorming en blijft hij gecentreerd. */}
                  <svg
                    viewBox="0 0 448 512"
                    fill="currentColor"
                    class="h-4 w-4"
                    aria-hidden="true"
                  >
                    <path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-12.4-58.4-43.4-58.4-23.7 0-37.8 15.9-44 31.3-2.3 5.5-2.9 13.2-2.9 20.9V448h-92.8s1.2-243.5 0-268.7h92.8v38.1c12.3-19 34.4-46.1 83.7-46.1 61.1 0 106.9 39.9 106.9 125.7V448z" />
                  </svg>
                </a>
              </li>
            )}
            {site.email && (
              <li>
                <a
                  href={`mailto:${site.email}`}
                  aria-label="E-mail"
                  class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-600 transition-colors hover:border-brand-500 hover:text-brand-600"
                >
                  <svg
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    class="h-4 w-4"
                    aria-hidden="true"
                  >
                    <rect x="3" y="5" width="14" height="11" rx="1.5" />
                    <path d="m3.5 6 6.5 5 6.5-5" />
                  </svg>
                </a>
              </li>
            )}
          </ul>
        )
      }
    </div>

    {
      columns.map((col) => (
        <nav aria-label={col.title}>
          <p class="text-[14px] font-semibold text-ink-950">{col.title}</p>
          {/* Ruime tikzones: op een telefoon zijn links van 17px niet
              betrouwbaar te raken. Negatieve marge houdt de uitlijning. */}
          <ul class="mt-3 space-y-0.5">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="-mx-2 inline-block rounded px-2 py-2 text-[13.5px] text-ink-600 transition-colors hover:text-brand-600"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div>
      <p class="text-[14px] font-semibold text-ink-950">Contact</p>
      {/* Rijen verschijnen pas wanneer de gegevens in site.ts staan */}
      <ul class="mt-4 space-y-3 text-[13.5px] text-ink-600">
        {
          site.phone && (
            <li class="flex items-center gap-2.5">
              <svg
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                class="h-4 w-4 shrink-0 text-brand-600"
                aria-hidden="true"
              >
                <path d="M4 3.5h3l1.5 4-2 1.5a11 11 0 0 0 4.5 4.5l1.5-2 4 1.5v3a1.5 1.5 0 0 1-1.6 1.5C8.3 17 3 11.7 2.5 5.1A1.5 1.5 0 0 1 4 3.5Z" />
              </svg>
              <a
                href={`tel:${site.phone.replace(/\s/g, '')}`}
                class="-my-1 inline-block py-1.5 hover:text-brand-600"
              >
                {site.phone}
              </a>
            </li>
          )
        }
        {
          site.email && (
            <li class="flex items-center gap-2.5">
              <svg
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                class="h-4 w-4 shrink-0 text-brand-600"
                aria-hidden="true"
              >
                <rect x="2.5" y="4.5" width="15" height="11" rx="1.5" />
                <path d="m3 6 7 5 7-5" />
              </svg>
              <a
                href={`mailto:${site.email}`}
                class="-my-1 inline-block py-1.5 hover:text-brand-600"
              >
                {site.email}
              </a>
            </li>
          )
        }
        {
          site.region && (
            <li class="flex items-center gap-2.5">
              <svg
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                class="h-4 w-4 shrink-0 text-brand-600"
                aria-hidden="true"
              >
                <path d="M10 18s-6-5.2-6-9.5a6 6 0 1 1 12 0C16 12.8 10 18 10 18Z" />
                <circle cx="10" cy="8.5" r="2" />
              </svg>
              {site.region}
            </li>
          )
        }
        <li>
          {site.shortName} BV · {site.address}
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div
      class="mx-auto flex w-full max-w-6xl flex-col gap-2 px-6 py-5 text-[12.5px] text-ink-500 md:flex-row md:items-center md:justify-between"
    >
      <p>
        © {site.shortName} Netwerkbeheer · {site.shortName} BV · {site.address}
        · BTW {site.btw}
      </p>
      <ul class="-my-1 flex flex-wrap gap-x-5">
        {/* Mét slash op het einde: /privacy stuurt 301 door naar /privacy/,
            dus dat kostte elke bezoeker een extra heen-en-weer. */}
        <li>
          <a
            href={`${home}privacy/`}
            class="inline-block py-1.5 transition-colors hover:text-brand-600"
            >Privacybeleid</a
          >
        </li>
        <li>
          <a
            href={`${home}privacy/#cookies`}
            class="inline-block py-1.5 transition-colors hover:text-brand-600"
            >Cookies</a
          >
        </li>
      </ul>
    </div>
  </div>
</footer>
