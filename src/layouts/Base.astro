---
import '../styles/global.css';
import { site } from '../data/site';
import { asset } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.seo.title, description = site.seo.description } =
  Astro.props;

// Canonieke URL: vertelt Google dat ce-it.be en www.ce-it.be dezelfde
// pagina zijn, zodat de autoriteit niet over twee adressen versplintert.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://ce-it.be')
  .href;

// Deelvoorbeeld (LinkedIn, WhatsApp, Google) — absolute URL vereist.
// JPEG, geen WebP: social crawlers gaan daar niet betrouwbaar mee om.
const ogImage = new URL(
  asset('images/og-image.jpg'),
  Astro.site ?? 'https://ce-it.be'
).href;

/**
 * Gestructureerde gegevens: koppelt het CE-iT logo en de bedrijfsgegevens
 * aan het domein, zodat Google weet welk logo bij dit bedrijf hoort.
 * Alleen geverifieerde gegevens — niets verzinnen.
 */
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: `${site.shortName} BV`,
  url: 'https://ce-it.be',
  logo: new URL(
    asset('images/logo/ce-it-logo-full.png'),
    Astro.site ?? 'https://ce-it.be'
  ).href,
  image: ogImage,
  description: site.seo.description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Sousbeekstraat 86',
    postalCode: '9250',
    addressLocality: 'Waasmunster',
    addressRegion: 'Oost-Vlaanderen',
    addressCountry: 'BE',
  },
  vatID: site.btw,
  ...(site.email ? { email: site.email } : {}),
  ...(site.phone ? { telephone: site.phone.replace(/\s/g, '') } : {}),
  ...(site.region ? { areaServed: site.region } : {}),
  // sameAs koppelt dit domein aan het officiële LinkedIn-profiel, zodat
  // Google beide als hetzelfde bedrijf herkent in plaats van als twee.
  ...(site.linkedin ? { sameAs: [site.linkedin] } : {}),
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="CE-iT Netwerkbeheer" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="CE-iT Netwerkbeheer — netwerk, wifi en bekabeling voor gebouwen en KMO’s"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#ffffff" />
    {/* Iconen uit het originele CE-iT logo (48px is wat Google in de
        zoekresultaten toont; 192/512 voor Android en snelkoppelingen) */}
    <link rel="icon" type="image/png" sizes="48x48" href={asset('favicon-48.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={asset('favicon-192.png')} />
    <link rel="icon" type="image/png" sizes="512x512" href={asset('favicon-512.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset('apple-touch-icon.png')} />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script is:inline>
      // Markeer dat JS beschikbaar is — scroll-reveal werkt alleen dan.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    {/* Wie met het toetsenbord navigeert, moest eerst door de hele
        navigatie heen voor de inhoud begon. Deze link is onzichtbaar tot
        hij focus krijgt. Doel: id="main", staat op elke pagina.
        Expres eigen CSS en geen `sr-only focus:not-sr-only`: dat laat het
        omschakelen afhangen van de volgorde waarin Tailwind de utilities
        uitschrijft. Zo is het hier zwart op wit. */}
    <a class="skip-link" href="#main">Naar de inhoud</a>
    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
        z-index: 60;
        border-radius: 0.375rem;
        background: var(--color-white);
        padding: 0.625rem 1rem;
        font-family: var(--font-body);
        font-size: 15px;
        font-weight: 500;
        color: var(--color-brand-600);
        box-shadow: 0 10px 25px rgb(10 22 32 / 0.18);
        outline: 2px solid var(--color-brand-600);
        outline-offset: 2px;
      }
    </style>
    <slot />
    <script>
      // Standaard scroll-reveal (04-ANIMATION-SPEC §10).
      const els = document.querySelectorAll('.reveal');
      const reduced = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;
      if (reduced || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('revealed'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
