---
import '../styles/global.css';
import { site } from '../data/site';
import { asset } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.seo.title, description = site.seo.description } =
  Astro.props;

// Canonieke URL: vertelt Google dat ce-it.be en www.ce-it.be dezelfde
// pagina zijn, zodat de autoriteit niet over twee adressen versplintert.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://ce-it.be')
  .href;

// Deelvoorbeeld (LinkedIn, WhatsApp, Google) — absolute URL vereist.
const ogImage = new URL(
  asset('images/og-image.png'),
  Astro.site ?? 'https://ce-it.be'
).href;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="CE-iT Netwerkbeheer" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="CE-iT Netwerkbeheer — netwerk, wifi en bekabeling voor gebouwen en KMO’s"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <script is:inline>
      // Markeer dat JS beschikbaar is — scroll-reveal werkt alleen dan.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Standaard scroll-reveal (04-ANIMATION-SPEC §10).
      const els = document.querySelectorAll('.reveal');
      const reduced = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;
      if (reduced || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('revealed'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
