---
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';

/**
 * Contactformulier via Web3Forms (https://web3forms.com — gratis).
 * Actief zodra `site.web3formsKey` is ingevuld in src/data/site.ts;
 * tot dan toont het formulier een duidelijke notitie.
 */
const formActive = Boolean(site.web3formsKey);

const fields = [
  { id: 'naam', label: 'Naam', type: 'text', autocomplete: 'name', required: true },
  {
    id: 'bedrijf',
    label: 'Bedrijf / organisatie',
    type: 'text',
    autocomplete: 'organization',
    required: false,
  },
  { id: 'email', label: 'E-mail', type: 'email', autocomplete: 'email', required: true },
  { id: 'telefoon', label: 'Telefoon', type: 'tel', autocomplete: 'tel', required: false },
];

const buildingTypes = [
  'Studentenhuisvesting',
  'Appartementsgebouw',
  'KMO / kantoor',
  'Nieuwbouwproject',
  'Andere',
];

const inputClasses =
  'w-full rounded-md border border-line bg-white px-4 py-3 text-[15px] text-ink-950 placeholder:text-ink-500 transition-colors focus:border-brand-500 focus:outline-none';
---

<Section id="contact">
  <div class="grid gap-12 md:grid-cols-2 md:gap-16">
    <div class="reveal">
      <Eyebrow>Contact</Eyebrow>
      <h2
        class="mt-3 font-display text-[28px] font-semibold leading-tight tracking-tight text-ink-950 md:text-[34px]"
      >
        Vertel ons over uw gebouw of project.
      </h2>
      <p class="mt-4 max-w-md text-[16px] leading-relaxed text-ink-600">
        We bekijken wat er nodig is en stellen een duidelijke aanpak voor.
        Vrijblijvend en concreet.
      </p>
    </div>

    <form
      id="contact-form"
      class="reveal space-y-5"
      method="POST"
      action={formActive ? 'https://api.web3forms.com/submit' : '#'}
      data-active={formActive ? 'true' : 'false'}
    >
      {formActive && (
        <>
          <input type="hidden" name="access_key" value={site.web3formsKey} />
          <input
            type="hidden"
            name="subject"
            value="Nieuwe aanvraag via ce-it.be"
          />
          <input type="hidden" name="from_name" value="CE-iT website" />
          {/* Honeypot tegen spam — onzichtbaar voor mensen */}
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none"
            tabindex="-1"
            aria-hidden="true"
          />
        </>
      )}

      <div class="grid gap-5 sm:grid-cols-2">
        {
          fields.map((field) => (
            <div>
              <label
                for={field.id}
                class="mb-1.5 block text-[13px] font-medium text-ink-800"
              >
                {field.label}
              </label>
              <input
                id={field.id}
                name={field.id}
                type={field.type}
                autocomplete={field.autocomplete}
                class={inputClasses}
                required={field.required}
              />
            </div>
          ))
        }
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label
            for="type-gebouw"
            class="mb-1.5 block text-[13px] font-medium text-ink-800"
          >
            Type gebouw
          </label>
          <select id="type-gebouw" name="type_gebouw" class={inputClasses}>
            <option value="">Maak een keuze</option>
            {buildingTypes.map((type) => <option value={type}>{type}</option>)}
          </select>
        </div>
        <div>
          <label
            for="locatie"
            class="mb-1.5 block text-[13px] font-medium text-ink-800"
          >
            Locatie
          </label>
          <input
            id="locatie"
            name="locatie"
            type="text"
            autocomplete="off"
            class={inputClasses}
          />
        </div>
      </div>

      <div>
        <label
          for="bericht"
          class="mb-1.5 block text-[13px] font-medium text-ink-800"
        >
          Bericht
        </label>
        <textarea id="bericht" name="bericht" rows="4" class={inputClasses}
        ></textarea>
      </div>

      <Button type="submit" class="w-full sm:w-auto">Verstuur aanvraag</Button>

      {/* Transparantie op het moment van verzamelen (AVG) */}
      <p class="text-[12.5px] leading-relaxed text-ink-500">
        We gebruiken uw gegevens enkel om uw vraag te beantwoorden. Meer
        hierover in ons{' '}
        <a
          href="/privacy"
          class="underline underline-offset-2 hover:text-brand-600"
          >privacybeleid</a
        >.
      </p>

      {/* Statusmelding na verzenden (JS vult deze) */}
      <p
        id="form-status"
        class="hidden text-[14px] leading-relaxed"
        role="status"
        aria-live="polite"
      >
      </p>

      {
        !formActive && (
          <p class="text-[13px] leading-relaxed text-ink-500">
            {/* Activeren: web3formsKey invullen in src/data/site.ts */}
            Het contactformulier wordt binnenkort geactiveerd. Bel of mail
            ons gerust rechtstreeks — de gegevens staan onderaan de pagina.
          </p>
        )
      }
    </form>
  </div>
</Section>

<script>
  /**
   * Verstuurt het formulier op de achtergrond naar Web3Forms, zodat de
   * bezoeker op ce-it.be blijft en meteen een bevestiging ziet.
   * Zonder JS valt het terug op een gewone POST (Web3Forms-bedankpagina).
   */
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form && form.dataset.active === 'true') {
    const status = document.getElementById('form-status');
    const button = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]'
    );
    const buttonLabel = button?.textContent?.trim() ?? 'Verstuur aanvraag';

    const showStatus = (message: string, ok: boolean) => {
      if (!status) return;
      status.textContent = message;
      status.classList.remove('hidden', 'text-brand-600', 'text-red-700');
      status.classList.add(ok ? 'text-brand-600' : 'text-red-700');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (button) {
        button.disabled = true;
        button.textContent = 'Versturen…';
      }
      status?.classList.add('hidden');

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(form),
        });
        const result = await response.json();

        if (response.ok && result.success) {
          form.reset();
          showStatus(
            'Bedankt — uw aanvraag is verstuurd. We nemen zo snel mogelijk contact op.',
            true
          );
        } else {
          throw new Error(result.message ?? 'Verzenden mislukt');
        }
      } catch {
        showStatus(
          'Verzenden lukte niet. Probeer het opnieuw of bereik ons rechtstreeks via de contactgegevens onderaan de pagina.',
          false
        );
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = buttonLabel;
        }
      }
    });
  }
</script>
